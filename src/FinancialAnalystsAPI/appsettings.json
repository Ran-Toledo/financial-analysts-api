{
  "ConnectionStrings": {
    "AnalystsDb": "Data Source=analysts.db"
  },
  "DataProvider": {
    "Name": "Fmp"
  },
  "Fmp": {
    "BaseUrl": "https://financialmodelingprep.com/stable/",
    "DailyCallBudget": 240,
    "PriceTargetPageSize": 100,
    "MaxPriceTargetPages": 10
  },
  "Tracking": {
    "Tickers": [
      "AAPL", "MSFT", "NVDA", "AMZN", "GOOGL", "META", "TSLA", "AMD", "INTC", "CRM", "NFLX",
      "JPM", "GS", "V",
      "UNH", "JNJ", "PFE",
      "XOM", "CVX",
      "PG", "KO", "WMT", "HD", "DIS", "BA"
    ],
    "BenchmarkTicker": "SPY"
  },
  "Ingestion": {
    "Enabled": true,
    "RunAtUtc": "22:30",
    "RunOnStartup": false,
    "BackfillYears": 3,
    "RatingsOverlapDays": 7
  },
  "ApiLimits": {
    "AnonymousPerMinute": 60,
    "ApiKeyPerMinute": 600,
    "CacheMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
